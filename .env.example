# Copy to .env and fill in real values. Never commit the real .env file.
# NOTION_TOKEN is an internal integration secret — treat it like a password.
NOTION_TOKEN=secret_xxx
NOTION_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Separate Citation Events data source (scripts/run_citations.py). Never the
# same ID as NOTION_DATA_SOURCE_ID above — see the required schema in that
# script's module docstring / README.
NOTION_CITATIONS_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ANTHROPIC_API_KEY is a secret — treat it like a password.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional. Model used for draft generation (scripts/generate_drafts.py).
# Defaults to claude-opus-5 when absent.
ANTHROPIC_MODEL=claude-opus-5
